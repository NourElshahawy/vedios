{
  "_readme": "Single source of truth for the edit. Times in seconds on the master timeline (30 fps, 1080x1920). VO cue times are ESTIMATES for an Egyptian read at natural pace; after recording, run tools/measure_vo.py and paste real line times into vo.lines, then shift shot boundaries that are marked follows_vo. Shots are expected at shots/<id>.mp4 (or shots/<id>_comp.mp4 after screen inserts/tracking are composited — the _comp version wins).",
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "duration": 58.5,
  "vo": {
    "mode": "lines_or_single",
    "single_file": "audio/vo.wav",
    "single_offset": 1.2,
    "lines": [
      {
        "id": "V1",
        "start": 1.2,
        "end": 4.0,
        "text": "لو كلود بيعمل مواقع… وشيج لسه فاتحة ليه؟"
      },
      {
        "id": "V2a",
        "start": 4.3,
        "end": 5.4,
        "text": "سؤال في محلّه."
      },
      {
        "id": "V2b",
        "start": 5.6,
        "end": 12.0,
        "text": "تقدر تفتح كلود دلوقتي، توصف له الموقع أو التطبيق اللي في دماغك، وتشوف نسخة منه قدامك في نفس اليوم."
      },
      {
        "id": "V3a",
        "start": 12.4,
        "end": 13.5,
        "text": "طب تخيّل معايا."
      },
      {
        "id": "V3b",
        "start": 13.7,
        "end": 19.4,
        "text": "عميل دخل موقعك من موبايله، اختار اللي عاوزه، وداس «ابعت الطلب». ظهر له «تم الإرسال»."
      },
      {
        "id": "V4",
        "start": 20.6,
        "end": 22.2,
        "text": "بس الطلب ما وصلكش."
      },
      {
        "id": "V5",
        "start": 24.2,
        "end": 28.6,
        "text": "هو فاكر إنك هترد عليه. وإنت أصلًا ما تعرفش إنه دخل."
      },
      {
        "id": "V6a",
        "start": 29.4,
        "end": 30.9,
        "text": "هنا بيبان شغلنا."
      },
      {
        "id": "V6b",
        "start": 31.1,
        "end": 38.2,
        "text": "قبل ما الموقع ينزل، بنجرّب الرحلة اللي عميلك هيمشيها فعلًا، من أول ما يفتح الصفحة لحد ما طلبه يوصلك."
      },
      {
        "id": "V6c",
        "start": 38.5,
        "end": 42.0,
        "text": "ولو خطوة وقفت، بنصلّحها قبل ما أول عميل يجرّبها."
      },
      {
        "id": "V7a",
        "start": 42.6,
        "end": 45.2,
        "text": "إنت عملت الموقع عشان يشيل عنك شغل."
      },
      {
        "id": "V7b",
        "start": 45.4,
        "end": 49.8,
        "text": "لو كل يوم هتسيب شغلك عشان تصلّح فيه، يبقى زوّد لك شغلانة."
      },
      {
        "id": "V8",
        "start": 53.0,
        "end": 55.8,
        "text": "وشيج — نصنع الرابط بين علامتك وعملائها"
      }
    ]
  },
