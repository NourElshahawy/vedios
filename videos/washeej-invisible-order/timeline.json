    "single_offset": 1.2,
    "_note": "Approved Gulf-dialect recording (client decision). audio/vo.wav = vo_original.wav with 1.2s of silence inserted at 24.9s (after «بس الطلب ما وصلك») for the impact beat; no words changed. Line times measured with Whisper + silencedetect.",
    "lines": [
      {
        "id": "V1",
        "start": 1.2,
        "end": 5.04,
        "text": "لو كلود يسوي مواقع، وشيج للحين موجودة ليه"
      },
      {
        "id": "V2a",
        "start": 6.04,
        "end": 6.81,
        "text": "سؤال في محله"
      },
      {
        "id": "V2b",
        "start": 7.72,
        "end": 13.76,
        "text": "تقدر تفتح كلود الحين، وتوصف له الموقع أو التطبيق اللي في بالك، وتشوف نسخة منه جدامك بنفس اليوم"
      },
      {
        "id": "V3a",
        "start": 14.67,
        "end": 16.05,
        "text": "طيب تخيل معي"
      },
      {
        "id": "V3b",
        "start": 16.59,
        "end": 23.86,
        "text": "عميل دخل موقعك من جواله، اختار اللي يبي، وضغط إرسال الطلب، وطلعت له رسالة «تم الإرسال»"
      },
      {
        "id": "V4",
        "start": 24.99,
        "end": 25.88,
        "text": "بس الطلب ما وصلك"
      },
      {
        "id": "V5",
        "start": 28.05,
        "end": 31.83,
        "text": "هو يحسب إنك بترد عليه، وإنت أصلًا ما تدري إنه دخل وطلب"
      },
      {
        "id": "V6a",
        "start": 33.16,
        "end": 33.96,
        "text": "هنا يبان شغلنا"
      },
      {
        "id": "V6b",
        "start": 34.73,
        "end": 41.4,
        "text": "قبل ما نطلق الموقع، نجرب الرحلة اللي عميلك بيمر فيها فعلًا، من أول ما يفتح الصفحة لين يوصل طلبه عندك"
      },
      {
        "id": "V6c",
        "start": 41.79,
        "end": 45.42,
        "text": "ولو فيه خطوة ما اشتغلت، نصلحها قبل ما يجربها أول عميل"
      },
      {
        "id": "V7a",
        "start": 46.48,
        "end": 48.55,
        "text": "إنت سويت الموقع عشان يخفف عنك الشغل"
      },
      {
        "id": "V7b",
        "start": 49.23,
        "end": 53.68,
        "text": "بس لو كل يوم بتترك شغلك عشان تصلح فيه، صار عندك شغلة زيادة بدل ما يريحك"
      },
      {
        "id": "V8",
        "start": 54.72,
        "end": 58.83,
        "text": "وشيج — نصنع الرابط بين علامتك وعملائها"
      }
    ]
  },
